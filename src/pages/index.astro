---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteMap from '../components/SiteMap.jsx';
import sites from '../data/sites.json';
import { getCollection } from 'astro:content';

const journalEntries = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latest = journalEntries[0];
---
<BaseLayout title="Home" mode="scholarly">
  <section class="hero">
    <p class="eyebrow">A Digital Humanities Field &amp; Textual Study</p>
    <h1>Ancient Medicine &amp; Healing: Word and Ritual in Greek Sanctuaries</h1>
    <p class="site-purpose">
      This site documents a month of summer 2026 fieldwork at Asclepieia and related
      healing sites across Greece — Epidauros, Kos, Trikka, and a wider circuit
      including Messene, Argos, Corinth, and Athens — read alongside the Hippocratic
      Corpus and the epigraphic record of dream healing. It brings together an
      interactive map, source dossiers for the textual and epigraphic evidence, and a
      chronological field journal, as a working research notebook rather than a
      finished argument.
    </p>
    <p class="hero-abstract">
      [PLACEHOLDER: 3–5 sentence abstract/thesis statement summarizing the research
      question — the relationship between the environmental-empirical medicine of the
      Hippocratic Corpus (Airs, Waters, Places; Epidemics) and the ritual, incubatory
      healing attested in the epigraphic record at Epidauros, Kos, and Trikka.]
    </p>
    <div class="hero-actions">
      <a class="button button--primary" href="/map">Explore the Interactive Map</a>
      <a class="button" href="/the-argument">Read the Argument</a>
    </div>
  </section>

  <section class="home-map-teaser">
    <h2>Sites</h2>
    <p>[PLACEHOLDER: one-sentence framing for the map teaser — toggle between the Hippocratic and cult-healing lenses below.]</p>
    <SiteMap client:only="react" sites={sites} />
  </section>

  <section class="home-journal-teaser">
    <h2>From the Field Journal</h2>
    {latest ? (
      <article class="journal-teaser-card">
        <p class="journal-teaser-card__date">
          {latest.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
        </p>
        <h3><a href={`/field-journal/${latest.slug}`}>{latest.data.title}</a></h3>
        <p>[PLACEHOLDER: short teaser excerpt of the latest entry.]</p>
      </article>
    ) : (
      <p>[PLACEHOLDER: no journal entries yet.]</p>
    )}
    <p><a href="/field-journal">All Field Journal entries &rarr;</a></p>
  </section>
</BaseLayout>
