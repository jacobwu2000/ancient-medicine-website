---
import { getCollection } from 'astro:content';
import JournalLayout from '../../layouts/JournalLayout.astro';
import RelatedSources from '../../components/RelatedSources.astro';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<JournalLayout title={entry.data.title}>
  <p class="eyebrow">Field Journal</p>
  <h1>{entry.data.title}</h1>
  <p class="journal-date">
    {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
    {entry.data.location ? ` — ${entry.data.location}` : ''}
  </p>
  <Content />
  <RelatedSources items={entry.data.relatedSources} />
</JournalLayout>
