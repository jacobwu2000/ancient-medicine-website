---
import ScholarlyLayout from '../../../layouts/ScholarlyLayout.astro';
import inscriptions from '../../../data/inscriptions.json';
import sites from '../../../data/sites.json';
---
<ScholarlyLayout title="Epigraphy">
  <p class="eyebrow">Sources</p>
  <h1>Epigraphy</h1>
  <p>
    [PLACEHOLDER: introduction to the epigraphic corpus — the Epidaurian iamata and
    related dream-healing inscriptions — and the editorial conventions used
    (edition, transcription style, translation policy).]
  </p>
  <ul class="epigraphy-list">
    {inscriptions.map((i) => {
      const site = sites.find((s) => s.id === i.siteId);
      return (
        <li>
          <a href={`/sources/epigraphy/${i.id}`}>{i.title}</a>
          {site && <> — <a href={`/sources/site-archaeology/${site.id}`}>{site.name}</a></>}
        </li>
      );
    })}
  </ul>
</ScholarlyLayout>
