---
import { url } from '../../../utils/url.js';
import { getCollection } from 'astro:content';
import ScholarlyLayout from '../../../layouts/ScholarlyLayout.astro';
import sites from '../../../data/sites.json';
import inscriptions from '../../../data/inscriptions.json';

export async function getStaticPaths() {
  const entries = await getCollection('site-archaeology');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const site = sites.find((s) => s.id === entry.data.siteId);
const relatedInscriptions = site
  ? inscriptions.filter((i) => site.relatedInscriptions.includes(i.id))
  : [];
---
<ScholarlyLayout title={entry.data.title}>
  <p class="eyebrow">Sources — Site Archaeology</p>
  <h1>{entry.data.title}</h1>
  {site && (
    <p class="site-quickfacts">
      {site.lat.toFixed(4)}, {site.lng.toFixed(4)} — <a href={url('/map')}>view on the interactive map</a>
    </p>
  )}

  <Content />

  {relatedInscriptions.length > 0 && (
    <aside class="related-panel">
      <h2>Related Inscriptions</h2>
      <ul>
        {relatedInscriptions.map((i) => (
          <li><a href={url(`/sources/epigraphy/${i.id}`)}>{i.title}</a></li>
        ))}
      </ul>
    </aside>
  )}
</ScholarlyLayout>
