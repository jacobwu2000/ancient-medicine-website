---
import { url } from '../../../utils/url.js';
import { getCollection } from 'astro:content';
import ScholarlyLayout from '../../../layouts/ScholarlyLayout.astro';
import sites from '../../../data/sites.json';

const dossiers = (await getCollection('site-archaeology')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---
<ScholarlyLayout title="Site Archaeology">
  <p class="eyebrow">Sources</p>
  <h1>Site Archaeology</h1>
  <p>
    [PLACEHOLDER: introduction to the site dossiers below. To add a new site,
    see the "How to add a new site" note in the project README.]
  </p>
  <ul class="index-list">
    {dossiers.map((d) => {
      const site = sites.find((s) => s.id === d.data.siteId);
      return (
        <li>
          <a href={url(`/sources/site-archaeology/${d.slug}`)}>{d.data.title}</a>
          {site && <> — {site.shortDescription}</>}
        </li>
      );
    })}
  </ul>
</ScholarlyLayout>
