---
import { getCollection } from 'astro:content';
import ScholarlyLayout from '../../../../layouts/ScholarlyLayout.astro';

const sections = (await getCollection('corpus', ({ data }) => data.work === 'epidemics')).sort(
  (a, b) => a.data.order - b.data.order
);
const constitutions = sections.filter((s) => s.data.kind === 'constitution');
const cases = sections.filter((s) => s.data.kind === 'case');
const other = sections.filter((s) => !s.data.kind);
const heading = (s) => s.data.label ?? `§${s.data.sectionNumber}`;
// Pages not yet annotated by the author (no highlight key) are flagged [WIP].
const wip = (s) => (s.data.highlightKey ? '' : ' [WIP]');
---
<ScholarlyLayout title="Epidemics">
  <p class="eyebrow">Sources — Hippocratic Corpus</p>
  <h1>Epidemics</h1>
  <p>[PLACEHOLDER: introduction to Epidemics — textual tradition, edition used, and its role in the project's argument.]</p>

  <h2>Constitutions</h2>
  <ol class="corpus-toc">
    {constitutions.map((s) => (
      <li>
        <a href={`/sources/hippocratic-corpus/epidemics/${s.slug}`}>{heading(s)}{s.data.title && `. ${s.data.title}`}{wip(s)}</a>
        {s.data.reference && <span class="corpus-toc-ref"> — {s.data.reference}</span>}
      </li>
    ))}
  </ol>

  <h2>Case histories</h2>
  {cases.length > 0 ? (
    <ol class="corpus-toc">
      {cases.map((s) => (
        <li>
          <a href={`/sources/hippocratic-corpus/epidemics/${s.slug}`}>{heading(s)}{s.data.title && `. ${s.data.title}`}{wip(s)}</a>
          {s.data.reference && <span class="corpus-toc-ref"> — {s.data.reference}</span>}
        </li>
      ))}
    </ol>
  ) : (
    <p>[PLACEHOLDER: 3–4 illustrative case histories, each tied to one of the constitutions above.]</p>
  )}

  {other.length > 0 && (
    <ol class="corpus-toc">
      {other.map((s) => (
        <li><a href={`/sources/hippocratic-corpus/epidemics/${s.slug}`}>{heading(s)}{s.data.title && `. ${s.data.title}`}{wip(s)}</a></li>
      ))}
    </ol>
  )}

  <h2>How passages are labeled</h2>
  <p>
    The four constitutions are numbered 1–4 in text order across both books:
    Constitutions 1–3 are the three in <em>Epidemics</em> I, and Constitution 4
    is the single constitution in <em>Epidemics</em> III. Jones heads the Book III
    section simply “Constitution”. The numbering is this site’s own shorthand,
    used for cross-reference and comparison.
  </p>
  <p>
    Within each page, passages carry the chapter numbers of W. H. S. Jones’s Loeb
    translation as encoded by the Perseus Digital Library, cited as
    “Epid. I 5” or “Epid. III 13”. Those numbers run continuously through each
    constitution in Book I (1–3, 4–12, 13–26). In Book III the constitution
    occupies chapters 2–16 of its section. Every chapter has its own link
    (for example <code>constitution-2#ch-5</code>), so the synopsis and
    <a href="/the-argument">The Argument</a> can point to a specific chapter.
  </p>
</ScholarlyLayout>
