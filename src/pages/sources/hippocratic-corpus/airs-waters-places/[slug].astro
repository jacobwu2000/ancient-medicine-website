---
import { getCollection } from 'astro:content';
import CorpusEntryLayout from '../../../../layouts/CorpusEntryLayout.astro';

export async function getStaticPaths() {
  const sections = await getCollection('corpus', ({ data }) => data.work === 'awp');
  return sections.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---
<CorpusEntryLayout entry={entry} />
