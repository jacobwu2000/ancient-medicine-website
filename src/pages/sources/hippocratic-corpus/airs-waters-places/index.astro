---
import { getCollection } from 'astro:content';
import ScholarlyLayout from '../../../../layouts/ScholarlyLayout.astro';

const sections = (await getCollection('corpus', ({ data }) => data.work === 'awp')).sort(
  (a, b) => a.data.order - b.data.order
);
const heading = (s) => s.data.label ?? `§${s.data.sectionNumber}`;
// Pages not yet annotated by the author (no highlight key) are flagged [WIP].
const wip = (s) => (s.data.highlightKey ? '' : ' [WIP]');
---
<ScholarlyLayout title="Airs, Waters, Places">
  <p class="eyebrow">Sources — Hippocratic Corpus</p>
  <h1>Airs, Waters, Places</h1>
  <p>[PLACEHOLDER: introduction to AWP — textual tradition, edition used, and its role in the project's argument.]</p>
  <ol class="corpus-toc">
    {sections.map((s) => (
      <li>
        <a href={`/sources/hippocratic-corpus/airs-waters-places/${s.slug}`}>{heading(s)}{s.data.title && `. ${s.data.title}`}{wip(s)}</a>
        {s.data.reference && <span class="corpus-toc-ref"> — {s.data.reference}</span>}
      </li>
    ))}
  </ol>

  <h2>How passages are labeled</h2>
  <p>
    Each page covers a run of chapters read together, named for the topic this
    site uses to group them. Chapters carry the numbers of W. H. S. Jones’s Loeb
    translation as encoded by the Perseus Digital Library, cited as “AWP 5”.
    Every chapter has its own link (for example <code>airs#ch-5</code>), so the
    synopsis and <a href="/the-argument">The Argument</a> can point to a
    specific chapter.
  </p>
</ScholarlyLayout>
