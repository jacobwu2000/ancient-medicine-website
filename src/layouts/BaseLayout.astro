---
import '../styles.css';

const {
  title = 'Ancient Medicine & Healing',
  description = 'A digital humanities study of ancient Greek medicine and healing, combining fieldwork with textual and epigraphic research.',
  mode = 'scholarly', // 'scholarly' | 'journal' — controls header accent and mode badge
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Ancient Medicine &amp; Healing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-mode={mode}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__row">
        <a class="site-title" href="/">
          <span class="site-title__main">Ancient Medicine &amp; Healing</span>
          <span class="site-title__sub">Word and Ritual in Greek Sanctuaries</span>
        </a>
        <span class="mode-badge" data-mode={mode}>
          {mode === 'journal' ? 'Field Journal' : 'Scholarly Apparatus'}
        </span>
      </div>
      <nav class="site-nav" aria-label="Primary">
        <div class="container site-nav__row">
          <a href="/">Home</a>
          <a href="/the-argument">The Argument</a>
          <a href="/map">Interactive Map</a>
          <a href="/sources">Sources</a>
          <a href="/field-journal">Field Journal</a>
          <a href="/bibliography">Bibliography</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          Ancient Medicine &amp; Healing — an undergraduate research project.
          Text marked <code>[PLACEHOLDER]</code> is scaffolding pending original research and citation.
        </p>
      </div>
    </footer>
  </body>
</html>
